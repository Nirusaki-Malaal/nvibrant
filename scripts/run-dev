#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Run the native Rust application from this checkout.
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
if [ ! -x "$root/.build/bin/nvibrant" ]; then
    printf '%s\n' 'Build first with: make' >&2
    exit 1
fi
exec "$root/.build/bin/nvibrant" "$@"
